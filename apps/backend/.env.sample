# Backend environment sample for SKYhome (DO NOT commit real secrets to source control)
# Copy this file to .env and fill values locally.

# SMTP / Gmail settings (required for sending emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=vayorainteriors@gmail.com
# SMTP_PASS must be a Gmail App Password (16-character) if the Gmail account uses 2FA
SMTP_PASS=

# Notification recipient (defaults to SMP user above)
VAYORA_EMAIL=vayorainteriors@gmail.com

# Backend port
PORT=5000

# Optional: Database connection (if you have Postgres configured)
# DATABASE_URL=postgresql://user:password@localhost:5432/skyhome_db?schema=public

# Note:
# 1. After creating .env, restart the backend: cd apps/backend && npm run dev
# 2. Do NOT add SMTP_PASS to frontend or any NEXT_PUBLIC_* variable.
# 3. Use a Gmail App Password for SMTP_PASS (see: https://support.google.com/accounts/answer/185833)
